not enforced)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;startArrow=none;elbow=vertical;fontSize=10;dashed=1;" edge="1" parent="1" source="reportsColl" target="topicsColl"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>